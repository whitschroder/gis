ss directions are best displayed with a discrete visualization, an example available here (under Layer Properties -> Symbology, select Singleband pseudocolor and Load color map from file): ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"xIer20YI33"},{"type":"link","url":"/direction-3805cbc527573e7fdc91947fcd17dc61.txt","static":true,"children":[{"type":"text","value":"direction.txt","key":"NQjWRwx4aA"}],"urlSource":"/direction.txt","protocol":"file","key":"FKrDsqdSX7"},{"type":"text","value":".","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"JgfyJGmCfu"}],"key":"jYLs9WcSV8"}],"key":"PGiU5VMLxb"},{"type":"heading","depth":2,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Euclidean Allocation","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"JJFwLGukbw"}],"identifier":"euclidean-allocation","label":"Euclidean Allocation","html_id":"euclidean-allocation","implicit":true,"key":"WzLkEwsAVY"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"bkUj6FjPHC"},{"type":"link","url":"https://pro.arcgis.com/en/pro-app/3.4/tool-reference/spatial-analyst/distance-allocation.htm","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Distance Allocation tool","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"rlA5EQHxhc"}],"urlSource":"https://pro.arcgis.com/en/pro-app/3.4/tool-reference/spatial-analyst/distance-allocation.htm","key":"zsltVKLCrC"},{"type":"text","value":" in ArcGIS Pro assigns each raster area of interest or feature class to its own zone, based on proximity to other raster areas of interest or feature classes. The resulting raster surface shows these zones with their 